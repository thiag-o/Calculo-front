# Shell app variables for the local environment. Copy to .env (which does not go to git).
# Warning: every VITE_* variable ends up in the browser JavaScript. Never put a secret here.

# Backend API address (local uvicorn).
VITE_API_URL=http://localhost:8000

# Environment name, shown in the interface outside production: local | homologacao | producao
VITE_AMBIENTE=local
