# Variáveis do app casca no ambiente local. Copie para .env (que não vai para o git).
# Atenção: toda variável VITE_* vai parar no JavaScript do navegador. Nunca coloque segredo aqui.

# Endereço da API do backend (uvicorn local).
VITE_API_URL=http://localhost:8000

# Nome do ambiente, mostrado na interface fora de produção: local | homologacao | producao
VITE_AMBIENTE=local
