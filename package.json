{
  "name": "fluxo-frontend",
  "private": true,
  "type": "module",
  "description": "Front do Fluxo de Cálculo: pacote @fluxo/react e app casca (hospedeiro zero).",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter shell dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "node scripts/check-control-chars.mjs && eslint .",
    "generate:api": "node scripts/generate-api.mjs",
    "changeset": "changeset",
    "release": "pnpm --filter @fluxo/react build && changeset publish",
    "e2e": "playwright test --project=simulated --pass-with-no-tests",
    "e2e:real": "playwright test --project=real --workers=2 --pass-with-no-tests"
  },
  "//": "e2e:real runs with 2 workers: on this machine, 6 browsers, the Vite dev server and the API together saturate CPU and memory and the sign-ins time out (global session decision, F39). e2e (simulated) keeps the default parallelism.",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
